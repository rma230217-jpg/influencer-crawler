# Supabase 프로젝트 설정
# 대시보드 왼쪽 하단 Settings → API Keys 에서 확인 (Project URL은 같은 페이지 상단 / Connect 다이얼로그)
# "Publishable and secret API keys" 탭 기준 (2025년 이후 새로 만든 프로젝트는 이 탭만 있습니다)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 서버 전용! 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트에 노출하지 마세요.
# 매일 자동 갱신(cron)에서 RLS를 우회해 전체 채널을 갱신하는 데 사용됩니다.
SUPABASE_SECRET_KEY=sb_secret_...

# 프로젝트가 예전 방식(Legacy API Keys: anon / service_role)만 제공한다면 위 두 개 대신 아래를 사용해도 됩니다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Cloud Console에서 발급한 YouTube Data API v3 키
YOUTUBE_API_KEY=AIza...

# /api/channels/refresh 를 보호하는 임의의 비밀 문자열 (Vercel Cron 호출 시 Authorization 헤더로 검증)
CRON_SECRET=아무-랜덤-문자열-직접-생성
