# Supabase 프로젝트 설정 (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 서버 전용! 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트에 노출하지 마세요.
# 매일 자동 갱신(cron)에서 RLS를 우회해 전체 채널을 갱신하는 데 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Cloud Console에서 발급한 YouTube Data API v3 키
YOUTUBE_API_KEY=AIza...

# /api/channels/refresh 를 보호하는 임의의 비밀 문자열 (Vercel Cron 호출 시 Authorization 헤더로 검증)
CRON_SECRET=아무-랜덤-문자열-직접-생성
